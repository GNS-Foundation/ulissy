{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ULissy",
  "scopeName": "source.ulissy",
  "fileTypes": ["ul"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#handles" },
    { "include": "#facets" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ulissy",
          "match": "//.*$"
        },
        {
          "name": "comment.line.documentation.ulissy",
          "match": "///.*$"
        },
        {
          "name": "comment.block.ulissy",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ulissy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ulissy",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.interpolation.ulissy",
              "begin": "\\\\\\(",
              "end": "\\)",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.ulissy" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.ulissy" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.ulissy",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ulissy",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ulissy",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.ulissy",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.ulissy",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ulissy",
          "match": "\\b\\d[\\d_]*\\b"
        },
        {
          "comment": "Unit values like 10.minutes, 500.meters",
          "name": "constant.numeric.unit.ulissy",
          "match": "\\b\\d+\\.(minutes|seconds|hours|days|milliseconds|meters|kilometers|miles|feet|percent)\\b",
          "captures": {
            "1": { "name": "support.type.unit.ulissy" }
          }
        }
      ]
    },
    "handles": {
      "patterns": [
        {
          "name": "entity.name.handle.ulissy",
          "match": "@[a-z][a-z0-9_]*",
          "captures": {
            "0": { "name": "variable.other.handle.ulissy" }
          }
        }
      ]
    },
    "facets": {
      "patterns": [
        {
          "comment": "Facet with path: home@user/lights",
          "name": "entity.name.facet.ulissy",
          "match": "\\b(dix|home|pay|email|car|chat)@([a-z][a-z0-9_]*)(/[a-z][a-z0-9_/]*)?\\b",
          "captures": {
            "1": { "name": "support.type.facet.ulissy" },
            "2": { "name": "variable.other.handle.ulissy" },
            "3": { "name": "string.unquoted.path.ulissy" }
          }
        },
        {
          "comment": "Organization facet: microsoft@user",
          "name": "entity.name.facet.org.ulissy",
          "match": "\\b([a-z][a-z0-9_]*)@([a-z][a-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.type.facet.org.ulissy" },
            "2": { "name": "variable.other.handle.ulissy" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.ulissy",
          "match": "\\b(if|else|match|case|guard|for|while|in|return|throw|throws)\\b"
        },
        {
          "name": "keyword.control.temporal.ulissy",
          "match": "\\b(every|when|after|within|timeout|budget)\\b"
        },
        {
          "name": "keyword.control.messaging.ulissy",
          "match": "\\b(send|to|from)\\b"
        },
        {
          "name": "keyword.control.async.ulissy",
          "match": "\\b(async|await)\\b"
        },
        {
          "name": "keyword.control.import.ulissy",
          "match": "\\b(import|export|as|with)\\b"
        },
        {
          "name": "keyword.other.ulissy",
          "match": "\\b(where|extend|trait|impl)\\b"
        },
        {
          "name": "constant.language.boolean.ulissy",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ulissy",
          "match": "\\b(nil)\\b"
        },
        {
          "name": "variable.language.ulissy",
          "match": "\\b(self|Self)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.identity.ulissy",
          "match": "\\b(identity)\\b"
        },
        {
          "name": "storage.type.variable.ulissy",
          "match": "\\b(let|var|const)\\b"
        },
        {
          "name": "storage.type.function.ulissy",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "storage.type.type.ulissy",
          "match": "\\b(type|struct|enum|config)\\b"
        },
        {
          "name": "storage.modifier.ulissy",
          "match": "\\b(public|private|internal|computed|invariant)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ulissy",
          "match": "\\b(Int|Float|Bool|String|Bytes|Uint64|Uint32|Byte|Nil)\\b"
        },
        {
          "name": "support.type.crypto.ulissy",
          "match": "\\b(Identity|PublicKey|PrivateKey|Signature|Hash|SharedSecret|Ciphertext|Nonce|Handle)\\b"
        },
        {
          "name": "support.type.spatial.ulissy",
          "match": "\\b(Coordinates|H3Cell|Distance|Heading|Resolution|Location)\\b"
        },
        {
          "name": "support.type.temporal.ulissy",
          "match": "\\b(Duration|Moment|Interval|Timeout|Timezone)\\b"
        },
        {
          "name": "support.type.sensor.ulissy",
          "match": "\\b(Percent|Battery|BatteryLevel|BatteryState|PowerMode|Gps|GpsState|Connectivity|ConnectivityState|Sensors|SensorContext)\\b"
        },
        {
          "name": "support.type.trajectory.ulissy",
          "match": "\\b(Breadcrumb|UnsignedBreadcrumb|Trajectory|Epoch|LocationSource|CollectionStatus)\\b"
        },
        {
          "name": "support.type.messaging.ulissy",
          "match": "\\b(Message|Envelope|Conversation|Visibility|FacetAddress)\\b"
        },
        {
          "name": "support.type.network.ulissy",
          "match": "\\b(Network|SyncStatus|PublishResult|GnsRecord|RelayChannel|HttpResponse)\\b"
        },
        {
          "name": "support.type.collection.ulissy",
          "match": "\\b(Array|Dict|Set|Option|Result)\\b"
        },
        {
          "name": "entity.name.type.ulissy",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ulissy",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.ulissy",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.ulissy",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.ulissy",
          "match": "(=|\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.optional.ulissy",
          "match": "(\\?\\.?|\\?\\?)"
        },
        {
          "name": "keyword.operator.range.ulissy",
          "match": "(\\.\\.<|\\.\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.ulissy",
          "match": "(->|=>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition",
          "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_]*)\\s*(<[^>]+>)?\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.ulissy" },
            "2": { "name": "entity.name.function.ulissy" },
            "3": { "name": "meta.generic.ulissy" }
          }
        },
        {
          "comment": "Function call",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.ulissy" }
          }
        },
        {
          "comment": "Method call",
          "match": "\\.([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.method.ulissy" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "comment": "Identity declaration",
          "match": "\\b(identity)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.identity.ulissy" },
            "2": { "name": "variable.other.identity.ulissy" }
          }
        },
        {
          "comment": "Variable declaration",
          "match": "\\b(let|var|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.variable.ulissy" },
            "2": { "name": "variable.other.ulissy" }
          }
        },
        {
          "comment": "Type declaration",
          "match": "\\b(type|struct|enum)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.type.ulissy" },
            "2": { "name": "entity.name.type.ulissy" }
          }
        },
        {
          "comment": "Config block",
          "match": "\\b(config)\\s*\\{",
          "captures": {
            "1": { "name": "storage.type.config.ulissy" }
          }
        },
        {
          "comment": "Computed property",
          "match": "\\b(computed)\\s+([a-z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "storage.modifier.computed.ulissy" },
            "2": { "name": "variable.other.property.ulissy" }
          }
        },
        {
          "comment": "Global constants",
          "name": "variable.other.constant.ulissy",
          "match": "\\b(now|here|battery|gps|sensors|connectivity|network)\\b"
        },
        {
          "comment": "Keychain",
          "name": "support.class.ulissy",
          "match": "\\b(Keychain|Battery|Location|Sensors|Network|Gps|Connectivity)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.ulissy",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.ulissy",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.ulissy",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.generic.ulissy",
          "match": "[<>]"
        },
        {
          "name": "punctuation.separator.ulissy",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.ulissy",
          "match": "\\."
        }
      ]
    }
  }
}
